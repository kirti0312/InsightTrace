# Copy this file to a new file named .env  and put your real values in it.
# .env is ignored by git, so your key never goes to GitHub. Never paste the key in chat.
GEMINI_API_KEY=paste_your_key_here

# Which Gemini model to use. Model names change, so look up what YOUR key can use:
#     python -m llm.client --list-models
# then copy one id here (for example a "flash" model), and test it with:
#     python -m llm.client --test
GEMINI_MODEL=

# Optional: set to off to skip the LLM entirely (the app then shows plain evidence summaries).
# LLM_MODE=off
